# Copia este archivo a .env.local y completa los valores desde tu proyecto
# de Supabase (Project Settings > API).

# Público (se usa en el navegador) — URL del proyecto y clave anónima.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SECRETO — solo se usa en el servidor (Server Actions / Route Handlers).
# NUNCA lo pongas en una variable NEXT_PUBLIC_* ni lo expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Opcional — solo si quieres el widget de "reproduciendo ahora" de Spotify.
# Crea una app en https://developer.spotify.com/dashboard y agrega
# http://localhost:3000/api/spotify/callback (y la URL de producción con el
# mismo /api/spotify/callback) en "Redirect URIs" dentro de esa app.
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...
